# Base URL of the REST API. All RTK Query endpoints are relative to this.
# In development MSW intercepts requests to this URL and serves mock data from src/mocks.
# Point it at your Express/MongoDB backend, e.g. http://localhost:5000/api
VITE_API_URL=/api

# MSW (mock API) switch.
#   development: mocks are ON unless this is "false" (set "false" when using a real backend)
#   production build: mocks are OFF unless this is "true" (useful for a static demo deploy)
VITE_ENABLE_MSW=true
